# ==============================================================================
# ETIMAD SUIT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# WARNING: NEVER commit real secrets or production credentials to version control.
# Copy this file to .env for local development and replace placeholders with dev values.

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & SERVER
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
APP_NAME="Etimad Suit"
PLATFORM_DOMAIN=etimadsuit.com
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
SELLER_DASHBOARD_URL=http://localhost:3001
STOREFRONT_ROOT_URL=http://localhost:3002
PLATFORM_ADMIN_URL=http://localhost:3003

# ------------------------------------------------------------------------------
# 2. DATABASE & CACHE
# ------------------------------------------------------------------------------
# Standalone development database for Etimad Suit. DO NOT connect to live production databases.
MONGODB_URI=mongodb://localhost:27017/etimad_suit_dev
MONGODB_DEBUG=false

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=replace_with_another_secure_random_64_character_hex_string
REFRESH_TOKEN_EXPIRES_IN=30d
COOKIE_SECRET=replace_with_secure_cookie_signing_secret
COOKIE_DOMAIN=localhost
DATA_ENCRYPTION_KEY=replace_with_32_byte_hex_key_for_encrypting_tenant_api_secrets

# ------------------------------------------------------------------------------
# 4. MEDIA & FILE STORAGE (CLOUDINARY / S3)
# ------------------------------------------------------------------------------
MEDIA_STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL & NOTIFICATIONS
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM=notifications@etimadsuit.com
EMAIL_FROM_NAME="Etimad Suit"
ADMIN_EMAIL=admin@etimadsuit.com

# ------------------------------------------------------------------------------
# 6. INTEGRATION DEFAULTS / MOCK PROVIDERS (Development Sandbox)
# ------------------------------------------------------------------------------
# Leopards Courier Service (LCS) Sandbox
LCS_BASE_URL=https://merchantapi.leopardscourier.com/api/
LCS_API_KEY=sandbox_api_key
LCS_API_PASSWORD=sandbox_api_password
LCS_ALLOW_PROD_PUSH=false
LCS_ORIGIN_CITY=Karachi

# PostEx Sandbox
POSTEX_BASE_URL=https://api.postex.pk/services/
POSTEX_API_TOKEN=sandbox_postex_token
POSTEX_PICKUP_ADDRESS_CODE=001
POSTEX_ENABLED=false

# M&P Courier Sandbox
MNP_BASE_URL=https://codapi.mulphilog.com/api/
MNP_USERNAME=sandbox_mnp_username
MNP_PASSWORD=sandbox_mnp_password
MNP_ACCOUNT_NO=sandbox_account_no

# ------------------------------------------------------------------------------
# 7. RATE LIMITING & SECURITY THRESHOLDS
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=10

